# CVG GeoServ Processor — Caddy reverse proxy config
# Maps geoserv.cleargeo.tech → localhost:8003
geoserv.cleargeo.tech {
    reverse_proxy geoserv-processor:8003

    encode gzip zstd

    log {
        output file /var/log/caddy/geoserv_access.log
        format json
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}
